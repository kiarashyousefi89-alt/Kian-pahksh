{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "volume": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "volume": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        },
        "required": [
          "volume",
          "price"
        ]
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "in_stock",
        "low_stock",
        "out_of_stock"
      ],
      "default": "in_stock"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}